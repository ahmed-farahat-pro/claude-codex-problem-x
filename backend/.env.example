# Copy to backend/.env and edit. Never commit the real .env file.

# deterministic = no paid inference, template drafts and rule-based tutor (use this first)
# gemini        = real model drafts and tutor reasoning through the Gemini API
FOURWEEKS_MODE=deterministic

# Only needed when FOURWEEKS_MODE=gemini. Keep it on the server; never put it in the frontend.
GEMINI_API_KEY=
FOURWEEKS_GEMINI_MODEL=gemini-3.5-flash-lite

FOURWEEKS_DB_PATH=./data/4weeks.db
FOURWEEKS_CONTENT_DIR=../content

# Local development login (POST /api/dev/learners). Turn off anywhere real learners exist.
FOURWEEKS_DEV_AUTH=true
FOURWEEKS_DEV_LIVE_ALLOWANCE_SECONDS=7200

# Session limits
FOURWEEKS_MAX_SESSION_SECONDS=600
FOURWEEKS_IDLE_TIMEOUT_SECONDS=300
FOURWEEKS_MAX_SESSION_MODEL_TOKENS=200000
FOURWEEKS_MAX_TOOL_CALLS_PER_TURN=8

FOURWEEKS_CORS_ORIGINS=http://localhost:5173
